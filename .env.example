# --- Required: the tutor brain. Server-side only, never sent to the browser. ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- Supabase: accounts, sync, profile pictures ---
# OPTIONAL. These already ship as built-in defaults in lib/config.ts, so
# sign-in works with nothing set here. Both are NEXT_PUBLIC_ and therefore
# public by design; row-level security is what protects the data. Set these
# only to point a fork at a different Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://fhitmtbhaqqqjfdjennl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Voice: natural speech instead of the browser's robotic default ---
# Without it the app falls back to the device's built-in voice, which still
# works but sounds synthetic. The free tier is ~10k characters per month.
ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Optional ---
# Your deployment's real URL — used for OAuth redirects and OpenRouter
# attribution. This is NOT guessable from the app's name: it comes from your
# Vercel PROJECT name. Copy it from the Vercel dashboard.
NEXT_PUBLIC_SITE_URL=https://mintai-three.vercel.app

# Override the free-model fallback chains if a model stops being free.
# OPENROUTER_TEXT_MODELS=openrouter/free,nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_VISION_MODELS=openrouter/free,inclusionai/ling-3.0-flash-vl:free

# Real YouTube results with thumbnails. Without it, recommendations open as
# YouTube searches instead, which works fine and costs nothing.
# YOUTUBE_API_KEY=
